.venv/
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/
.env*

# Datos por cliente (generados por scripts/nuevo_cliente.py, mismo patrón
# que Contalibra/Restolibra) y datos locales de -dev.
/clientes/
dev-data/

# Config de NPM (credenciales de Nginx Proxy Manager para scripts/npm_*.py).
scripts/.npm_config.json

# Frontend (ver ADR-019): node_modules y el build no se versionan --
# el build de produccion lo genera el Dockerfile (stage node:20-slim).
frontend/node_modules/
frontend/dist/

# Artefactos de cobertura (agregado 2026-07-31, junto con el paso de coverage
# en el CI). Son salida de la herramienta, se regeneran en cada corrida y el
# .coverage es un binario de ~100-250 KB: no van al repo.
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/
frontend/coverage/

# ── Solo-VPS (agregado 2026-08-02 al desplegar el backoffice de la suite) ────
# Nada de esto se versiona: son archivos que solo existen en el servidor y
# varios llevan secretos. Un untracked con credenciales adentro esta a un
# `git add -A` de entrar al repo.
# compose del backoffice, generado en el VPS
admin/
# venv de los scripts de provisioning
.venv-scripts/
\.env
\.env.*
!.env.example
config.local.*
credentials.*
secrets.*
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.sql
*.dump
*.bak
*.backup
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
data/
logs/
*.log

# Excepcion a `*.sql`: el init del sidecar PostgreSQL es codigo de
# infraestructura, no un dump. Sin versionarlo, el sidecar del VPS arranca sin
# la base de LibraCore y el producto no levanta.
!docker/postgres-init/*.sql
